		public void Main()
		{
			// TODO: Add your code here

            // User::FilePath,User::YYYYMM,User:: ShouldMoveFile,User::MoveFileResult

            string FilePath = (string)Dts.Variables["User::FilePath"].Value;
            string YYYYMM = (string)Dts.Variables["User::YYYYMM"].Value;
            string FileName = System.IO.Path.GetFileName(FilePath);

            if (FileName.Contains(YYYYMM))
            {
                Dts.Variables["User::ShouldMoveFile"].Value = true;
            }
            else
            {
                Dts.Variables["User::ShouldMoveFile"].Value = false;
            }
            Dts.TaskResult = (int)ScriptResults.Success;

        }

