          DTS:IncludeInDebugDump="2345"
          DTS:Namespace="User"
          DTS:ObjectName="lowerBoundary">
          <DTS:VariableValue
            DTS:DataType="8"
            xml:space="preserve"></DTS:VariableValue>
        </DTS:Variable>
        <DTS:Variable
          DTS:CreationName=""
          DTS:DTSID="{06ABBECC-01A7-4AEF-B82F-D0C51F162984}"
          DTS:IncludeInDebugDump="2345"
          DTS:Namespace="User"
          DTS:ObjectName="personLookupQuery">
          <DTS:VariableValue
            DTS:DataType="8">SELECT CAST(Person.LastName + COALESCE(N' ' + Person.MiddleName, N'') + N', ' + Person.FirstName AS NVARCHAR(256)) as ClientName        ,Person.BusinessEntityID AS BusinessEntityID 	   ,CAST(1 AS BIT) AS IsPerson   FROM Person.Person</DTS:VariableValue>
        </DTS:Variable>
        <DTS:Variable
          DTS:CreationName=""
          DTS:DTSID="{F137C73A-7FDF-4035-80B3-98E6BB7525EA}"
          DTS:IncludeInDebugDump="2345"
          DTS:Namespace="User"
          DTS:ObjectName="upperBoundary">
          <DTS:VariableValue
            DTS:DataType="8"
            xml:space="preserve"></DTS:VariableValue>
        </DTS:Variable>
      </DTS:Variables>
      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\Foreach File\Lower Boundary"
          DTS:CreationName="Microsoft.ExpressionTask"
          DTS:Description="Expression Task"
          DTS:DTSID="{A18094A9-AD80-4BE3-8E96-CB56C96F8BE2}"
          DTS:ExecutableType="Microsoft.ExpressionTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Lower Boundary"
          DTS:TaskContact="Expression Task;Microsoft Corporation; SQL Server vNext CTP2.0; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <ExpressionTask
              Expression="@[User::lowerBoundary]:= SUBSTRING( @[User::currentFileName] , FINDSTRING( @[User::currentFileName] , &quot;_&quot;, 1) + 1 , 1 )" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Foreach File\Person Lookup Query"
          DTS:CreationName="Microsoft.ExpressionTask"
          DTS:Description="Expression Task"
          DTS:DTSID="{7F346B70-EC7E-4784-AAFE-2A9A64374C8A}"
          DTS:ExecutableType="Microsoft.ExpressionTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Person Lookup Query"
          DTS:TaskContact="Expression Task;Microsoft Corporation; SQL Server vNext CTP2.0; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <ExpressionTask
              Expression="@[User::personLookupQuery]:=&quot;SELECT *&#xA; FROM&#xA;  (&#xA;  SELECT CAST(Person.LastName + COALESCE(N' ' + Person.MiddleName, N'') + N', ' + Person.FirstName AS NVARCHAR(256)) as ClientName&#xA;         ,Person.BusinessEntityID AS BusinessEntityID&#xA;         ,CAST(1 AS BIT) AS IsPerson&#xA;    FROM Person.Person&#xA;  ) RefTable&#xA;WHERE (RefTable.ClientName BETWEEN '&quot; + @[User::lowerBoundary]  + &quot;' AND '&quot; + @[User::upperBoundary]  + &quot;');&quot;" />
          </DTS:ObjectData>
        </DTS:Executable>
